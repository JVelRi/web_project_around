{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["ES2018", "DOM"],
    "module": "ES6",
    "rootDir": "./src",
    "outDir": "./public",
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
